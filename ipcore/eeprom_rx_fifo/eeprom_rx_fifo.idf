<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>02100205</id>
        <display_name>DRM Based FIFO</display_name>
        <version>1.14</version>
        <instance>eeprom_rx_fifo</instance>
        <family>Logos</family>
        <device>PGL50H</device>
        <package>FBG484</package>
        <speedgrade>-6</speedgrade>
        <generator version="2025.2" build="211867">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>ALMOST_EMPTY_NUM</name>
            <type>int</type>
            <value>4</value>
        </param>
        <param>
            <name>ALMOST_FULL_NUM</name>
            <type>int</type>
            <value>31</value>
        </param>
        <param>
            <name>ASYN_FIFO_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>BE_WIDTH</name>
            <type>int</type>
            <value>1</value>
        </param>
        <param>
            <name>BYTE_SIZE</name>
            <type>enum</type>
            <value>8</value>
        </param>
        <param>
            <name>DATA_VALID_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>DRM_MODE_SEL</name>
            <type>enum</type>
            <value>AUTO</value>
        </param>
        <param>
            <name>EMPTY_WL_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>FIFO_TYPE</name>
            <type>enum</type>
            <value>SYN_FIFO</value>
        </param>
        <param>
            <name>FULL_WL_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>MODE_18K</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>MODE_9K</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>OUTPUT_REG</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>POWER_OPT</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>PREFETCH_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>RD_BE_WIDTH</name>
            <type>int</type>
            <value>1</value>
        </param>
        <param>
            <name>RD_CLK_OR_POL_INV</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>RD_DATA_WIDTH</name>
            <type>int</type>
            <value>21</value>
        </param>
        <param>
            <name>RD_DEPTH_WIDTH</name>
            <type>int</type>
            <value>5</value>
        </param>
        <param>
            <name>RD_OCE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>RESET_TYPE</name>
            <type>enum</type>
            <value>ASYNC</value>
        </param>
        <param>
            <name>RST_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>SAMEWIDTH_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>WR_BYTE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>WR_DATA_WIDTH</name>
            <type>int</type>
            <value>21</value>
        </param>
        <param>
            <name>WR_DEPTH_WIDTH</name>
            <type>int</type>
            <value>5</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>clk</name>
            <text>clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rst</name>
            <text>rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>wr_clk</name>
            <text>wr_clk</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>wr_rst</name>
            <text>wr_rst</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>wr_en</name>
            <text>wr_en</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>wr_data</name>
            <text>wr_data</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>20</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>wr_byte_en</name>
            <text>wr_byte_en</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
            <msb>0</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>wr_full</name>
            <text>wr_full</text>
            <dir>output</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>wr_water_level</name>
            <text>wr_water_level</text>
            <visible>0</visible>
            <dir>output</dir>
            <pos>left</pos>
            <msb>5</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>almost_full</name>
            <text>almost_full</text>
            <dir>output</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rd_clk</name>
            <text>rd_clk</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>rd_rst</name>
            <text>rd_rst</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>rd_en</name>
            <text>rd_en</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>rd_data</name>
            <text>rd_data</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>20</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>rd_oce</name>
            <text>rd_oce</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>rd_empty</name>
            <text>rd_empty</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>rd_water_level</name>
            <text>rd_water_level</text>
            <visible>0</visible>
            <dir>output</dir>
            <pos>right</pos>
            <msb>5</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>almost_empty</name>
            <text>almost_empty</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>data_valid</name>
            <text>data_valid</text>
            <visible>0</visible>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
    </pin_list>
    <synthesis>
        <script><![CDATA[set_option -vlog_std v2001]]></script>
        <script><![CDATA[set_option -disable_io_insertion 1]]></script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="eeprom_rx_fifo_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="eeprom_rx_fifo_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="eeprom_rx_fifo_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipml_fifo_ctrl_v1_14_eeprom_rx_fifo.v"/>
            <file pathname="rtl/ipml_sdpram_v1_13_eeprom_rx_fifo.v"/>
            <file pathname="rtl/ipml_fifo_v1_14_eeprom_rx_fifo.v"/>
            <file pathname="eeprom_rx_fifo.v"/>
        </source>
        <specs>
            <sdc pathname="ipml_drm_fifo.sdc"/>
        </specs>
    </file_list>
</ip_inst>
