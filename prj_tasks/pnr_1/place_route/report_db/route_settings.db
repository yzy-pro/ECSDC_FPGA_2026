                    </row>
                    <row>
                        <data>Pin Cost Increasing Speed</data>
                        <data>300</data>
                    </row>
                    <row>
                        <data>CE/RS signal series limit</data>
                        <data>500</data>
                    </row>
                    <row>
                        <data>Enable Recovery Analysis in Routing</data>
                        <data>true</data>
