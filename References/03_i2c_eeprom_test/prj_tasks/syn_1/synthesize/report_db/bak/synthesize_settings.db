<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<tables>
    <general_container id="synthesize_settings">
        <table_container>
            <table id="synthesize_settings" title="Synthesize Settings" column_number="2">
                <column_headers>
                    <data>Name</data>
                    <data>Value</data>
                </column_headers>
                <row>
                    <data>Part</data>
                    <data>PGL50H-6FBG484</data>
                </row>
                <row>
                    <data>Top Module</data>
                    <data>i2c_eeprom_test</data>
                </row>
            </table>
        </table_container>
        <general_container align="3">
            <table_container>
                <data>Option</data>
                <table id="" title="" column_number="2">
                    <column_headers>
                        <data>Name</data>
                        <data>Value</data>
                    </column_headers>
                    <row>
                        <data>Minimum Control-set Size</data>
                        <data>2</data>
                    </row>
                    <row>
                        <data>Maximum DRM Cascade Height</data>
                        <data>-1</data>
                    </row>
                </table>
            </table_container>
            <table_container>
                <data>Options</data>
                <table id="" title="" column_number="2">
                    <column_headers>
                        <data>Name</data>
                        <data>Value</data>
                    </column_headers>
                    <row>
                        <data>Maximum number of parallel synthesis jobs</data>
                        <data>4</data>
                    </row>
                </table>
            </table_container>
            <table_container>
                <data>Constraints</data>
                <table id="" title="" column_number="2">
                    <column_headers>
                        <data>Name</data>
                        <data>Value</data>
                    </column_headers>
                    <row>
                        <data>Frequency (MHz)</data>
                        <data>1</data>
                    </row>
                    <row>
                        <data>Use Clock Period for Unconstrained IO</data>
                        <data>false</data>
                    </row>
                </table>
            </table_container>
            <table_container>
                <data>Timing Report</data>
                <table id="" title="" column_number="2">
                    <column_headers>
                        <data>Name</data>
                        <data>Value</data>
                    </column_headers>
                    <row>
                        <data>Total Number of Paths (-max_path)</data>
                        <data>3</data>
                    </row>
                    <row>
                        <data>Number of Paths per Endpoint (-nworst)</data>
                        <data>1</data>
                    </row>
                    <row>
                        <data>Number of Carry as One Logic Level</data>
                        <data>4</data>
                    </row>
                    <row>
                        <data>Report Logic Level Distribution</data>
                        <data>false</data>
                    </row>
                    <row>
                        <data>Max Path of Per Logic Level</data>
                        <data>100</data>
                    </row>
                    <row>
                        <data>Report Exception</data>
                        <data>true</data>
                    </row>
                    <row>
                        <data>Report CDC</data>
                        <data>true</data>
                    </row>
                </table>
            </table_container>
            <table_container>
                <data>High Reliability (Beta)</data>
                <table id="" title="" column_number="2">
                    <column_headers>
                        <data>Name</data>
                        <data>Value</data>
                    </column_headers>
                    <row>
                        <data>FSM Safe Encoding</data>
                        <data>none</data>
                    </row>
                    <row>
                        <data>Enable High Reliability</data>
                        <data>false</data>
                    </row>
                    <row>
                        <data>Triplicate Inputs</data>
                        <data>converged</data>
                    </row>
                    <row>
                        <data>Triplicate Outputs</data>
                        <data>converged</data>
                    </row>
                </table>
            </table_container>
            <table_container>
                <data>Partition Block (Beta)</data>
                <table id="" title="" column_number="2">
                    <column_headers>
                        <data>Name</data>
                        <data>Value</data>
                    </column_headers>
                    <row>
                        <data>Automatic Partition Block</data>
                        <data>false</data>
                    </row>
                    <row>
                        <data>Maximum number of parallel synthesis jobs</data>
                        <data>4</data>
                    </row>
                </table>
            </table_container>
        </general_container>
    </general_container>
</tables>