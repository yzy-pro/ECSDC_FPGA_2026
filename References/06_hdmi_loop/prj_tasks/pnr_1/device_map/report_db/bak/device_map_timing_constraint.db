<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<tables>
    <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -period {1000} -waveform {0 500} -name {hdmi_loop|pixclk_in} [get_ports {pixclk_in}] -add</data>
        </row>
        <row>
            <data>create_clock -period {1000} -waveform {0 500} -name {hdmi_loop|sys_clk} [get_ports {sys_clk}] -add</data>
        </row>
        <row>
            <data>create_clock -period {1000} -waveform {0 500} -name {PLL|u_pll/u_pll_e3/CLKOUT0} [get_pins {u_pll/u_pll_e3.CLKOUT0}] -add</data>
        </row>
        <row>
            <data>set_clock_groups -name {hdmi_loop|Inferred_clock_group_0} -asynchronous -group [get_clocks {hdmi_loop|pixclk_in}]</data>
        </row>
        <row>
            <data>set_clock_groups -name {hdmi_loop|Inferred_clock_group_1} -asynchronous -group [get_clocks {hdmi_loop|sys_clk}]</data>
        </row>
        <row>
            <data>set_clock_groups -name {hdmi_loop|Inferred_clock_group_2} -asynchronous -group [get_clocks {PLL|u_pll/u_pll_e3/CLKOUT0}]</data>
        </row>
    </table>
</tables>