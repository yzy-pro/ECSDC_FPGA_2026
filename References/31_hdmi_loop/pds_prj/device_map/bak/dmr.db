    <general_container id="device_map_timing_constraint" align="1">
        <table_container>
            <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}</data>
                </row>
                <row>
                    <data>create_clock -name {DebugCore_JCLK} [get_pins {u_GTP_SCANCHAIN_PG.TCK_USER}] -period {50.000} -waveform {0.000 25.000}</data>
                </row>
                <row>
                    <data>create_clock -name {DebugCore_CAPTURE} [get_pins {u_GTP_SCANCHAIN_PG.CAPDR}] -period {100.000} -waveform {25.000 75.000}</data>
                </row>
                <row>
                    <data>set_clock_groups -name {DebugCoreClockGroup} -asynchronous -group {DebugCore_JCLK DebugCore_CAPTURE}</data>
                </row>
            </table>
        </table_container>
        <table_container>
            <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_clock  -name {hdmi_i2c_inst/i2c_ctrl_inst/i2c_clk/Q[0]_Inferred} -period {1000} -waveform { 0 500}  [get_pins {hdmi_i2c_inst/i2c_ctrl_inst/i2c_clk.Q}]  -add</data>
                </row>
            </table>
        </table_container>
    </general_container>
