create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}

define_attribute {p:sda} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:sda} {PAP_IO_LOC} {N19}
define_attribute {p:sda} {PAP_IO_VCCIO} {3.3}
define_attribute {p:sda} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:sda} {PAP_IO_DRIVE} {12}
define_attribute {p:sda} {PAP_IO_NONE} {TRUE}
define_attribute {p:sda} {PAP_IO_SLEW} {FAST}
define_attribute {p:scl} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:scl} {PAP_IO_LOC} {P19}
define_attribute {p:scl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:scl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:scl} {PAP_IO_DRIVE} {12}
define_attribute {p:scl} {PAP_IO_UNUSED} {TRUE}
define_attribute {p:scl} {PAP_IO_SLEW} {FAST}
define_attribute {p:tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:tx} {PAP_IO_LOC} {L24}
define_attribute {p:tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:tx} {PAP_IO_DRIVE} {12}
define_attribute {p:tx} {PAP_IO_UNUSED} {TRUE}
define_attribute {p:tx} {PAP_IO_SLEW} {FAST}
define_attribute {p:key_rd} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:key_rd} {PAP_IO_LOC} {R26}
define_attribute {p:key_rd} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key_rd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key_rd} {PAP_IO_UNUSED} {TRUE}
define_attribute {p:key_wr} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:key_wr} {PAP_IO_LOC} {P26}
define_attribute {p:key_wr} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key_wr} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key_wr} {PAP_IO_UNUSED} {TRUE}
define_attribute {p:sys_clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:sys_clk} {PAP_IO_LOC} {R3}
define_attribute {p:sys_clk} {PAP_IO_VCCIO} {1.5}
define_attribute {p:sys_clk} {PAP_IO_STANDARD} {LVCMOS15}
define_attribute {p:sys_clk} {PAP_IO_UNUSED} {TRUE}
define_attribute {p:sys_rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:sys_rst_n} {PAP_IO_LOC} {G25}
define_attribute {p:sys_rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:sys_rst_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:sys_rst_n} {PAP_IO_NONE} {TRUE}
