<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<tables>
    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name clk_a -period 6.734 [get_ports clk_a]</data>
        </row>
        <row>
            <data>create_clock -name clk_b -period 10.000 [get_ports clk_b]</data>
        </row>
        <row>
            <data>set_clock_groups -asynchronous -group [get_clocks clk_a] -group [get_clocks clk_b]</data>
        </row>
        <row>
            <data>set_max_skew 0.001 -from [get_cells {gray[*]}] -to [get_cells {sync1[*]}]</data>
        </row>
    </table>
</tables>