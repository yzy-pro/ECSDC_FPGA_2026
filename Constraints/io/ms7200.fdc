# hdmi输入芯片ms7200 i2c控制
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_LOC} {V19}
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_DRIVE} {8}
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_NONE} {TRUE}
define_attribute {p:sys_ms7200_iic_scl} {PAP_IO_SLEW} {FAST}

define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_LOC} {V20}
define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_VCCIO} {3.3}
define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_DRIVE} {8}
define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_NONE} {TRUE}
define_attribute {p:sys_ms7200_iic_sda} {PAP_IO_SLEW} {FAST}

# hdmi输入芯片ms7200 硬件复位信号(与ms7210共用1路硬件复位信号)
define_attribute {p:sys_ms7200_rstn} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:sys_ms7200_rstn} {PAP_IO_LOC} {R17}
define_attribute {p:sys_ms7200_rstn} {PAP_IO_VCCIO} {3.3}
define_attribute {p:sys_ms7200_rstn} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:sys_ms7200_rstn} {PAP_IO_DRIVE} {8}
define_attribute {p:sys_ms7200_rstn} {PAP_IO_NONE} {TRUE}
define_attribute {p:sys_ms7200_rstn} {PAP_IO_SLEW} {FAST}